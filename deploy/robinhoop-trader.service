[Unit]
Description=robinhoop-trader live trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/robinhoop-trader
EnvironmentFile=/opt/robinhoop-trader/.env
ExecStart=/usr/bin/java -Xmx384m -jar /opt/robinhoop-trader/robinhoop-trader.jar live
Restart=on-failure
RestartSec=30
User=robinhoop
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
