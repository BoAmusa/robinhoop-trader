# Copy to /opt/robinhoop-trader/.env on the server (chmod 600) and fill in real values.
# Never commit the filled-in file.

ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_ACCOUNT_NUMBER=401909924

# Keep as false until you've watched dry-run output during real market hours and are
# comfortable with what it proposes.
LIVE_TRADING_ENABLED=false

# manual = blocks on a console y/N per trade (only works with an attached terminal).
# auto   = executes any trade that passes the risk manager with no human step. Required
#          for headless/unattended hosting.
TRADE_APPROVAL_MODE=auto

MAX_POSITION_PCT=0.05
MAX_DAILY_LOSS_PCT=0.02
CHECK_INTERVAL_MINUTES=15
HISTORY_DAYS=120
